---
import '../styles/tokens.css';
import '../styles/global.css';

const { title, description, section = 'board' } = Astro.props as {
  title: string;
  description: string;
  section?: 'board' | 'shop' | 'intake' | 'model' | 'provenance';
};
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} · ReelDeal</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner shell">
        <a class="brand" href={base} aria-label="ReelDeal home">ReelDeal</a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={base} aria-current={section === 'board' ? 'page' : undefined}>Board</a>
          <a href={`${base}shop/`} aria-current={section === 'shop' ? 'page' : undefined}>Shop</a>
          <a href={`${base}intake/`} aria-current={section === 'intake' ? 'page' : undefined}>Intake</a>
          <a href={`${base}provenance/`} aria-current={section === 'provenance' ? 'page' : undefined}>Proof</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="site-footer__inner shell">
        <p>Kesennuma market workflow · demonstration</p>
        <p>No real fish or payments</p>
      </div>
    </footer>
  </body>
</html>
