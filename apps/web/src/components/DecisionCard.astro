---
import { GATE, type GateResult, type TypedDecisionInput } from '../../../../packages/domain/src/index';

type Props = {
  decision: TypedDecisionInput;
  outcome: GateResult;
  questionLabel?: string;
};

const { decision, outcome, questionLabel } = Astro.props;
const cardId = `decision-${(decision.decision_id ?? `${decision.scan_id}-${decision.question_id}`).replace(/[^a-zA-Z0-9_-]/g, '-')}`;
const titleId = `${cardId}-answer`;
const meterLabelId = `${cardId}-confidence`;
const confidencePercent = new Intl.NumberFormat('en', { style: 'percent', maximumFractionDigits: 1 }).format(decision.confidence);
const scorePercent = decision.score === null
  ? null
  : new Intl.NumberFormat('en', { style: 'percent', maximumFractionDigits: 1 }).format(decision.score);

const questionNames: Record<string, string> = {
  grade: 'Measured size bracket',
  quality: 'Recorded handling evidence',
  price_ok: 'Required facts complete?',
  completeness: 'Required facts complete?',
};
const choiceNames: Record<string, string> = {
  small: 'Small bracket',
  medium: 'Medium bracket',
  large: 'Large bracket',
};
const reasonNames: Record<string, string> = {
  noul: 'Required facts are incomplete or the answer is no.',
  missing_measurements: 'A required measurement is missing, unstable, or inconsistent.',
  unconfirmed_species: 'An operator has not confirmed the species.',
  low_decision_confidence: `The decision is below the ${Math.round(GATE.confidenceMin * 100)}% eligibility threshold.`,
  low_species_confidence: 'The species hint is too weak for automatic approval.',
  conflicting_species: 'The species hints conflict with each other or the operator label.',
};
const sourceNames = {
  laya_entropy: 'Model answer concentration',
  laya_noul_probability: 'Binary answer concentration',
  stub_heuristic: 'Deterministic rule score',
  policy_required_input: 'Known missing-input rule',
} as const;

const question = questionLabel ?? questionNames[decision.question_id] ?? decision.question_id.replaceAll('_', ' ');
const kindLabel = decision.kind === 'noul' ? 'Yes / no' : decision.kind === 'score' ? 'Score' : 'Choice';
const choice = decision.choice ? (choiceNames[decision.choice] ?? decision.choice.replaceAll('_', ' ')) : 'No choice recorded';
const answer = decision.kind === 'choice' ? choice : decision.kind === 'score' ? (scorePercent ?? 'No score recorded') : decision.noul_value ? 'Yes' : 'No';
const answerNote = decision.kind === 'noul'
  ? decision.noul_value ? 'The stated condition is met.' : 'Required facts need operator review.'
  : decision.kind === 'score' ? `Display level ${(decision.score_level ?? 0) + 1} of 5 · continuous score ${scorePercent ?? 'unavailable'}`
  : 'Advisory classification of the recorded facts.';
const reviewLabel = outcome.route === 'auto_approve' ? 'Eligible for approval' : 'Human review required';
const reviewDescription = outcome.route === 'auto_approve'
  ? 'The recorded facts meet the review policy. A seller still controls publication.'
  : reasonNames[outcome.reason];
---

<article class:list={['decision-card', outcome.route === 'pending_review' && 'decision-card--review']} aria-labelledby={titleId}>
  <header class="decision-card__answer">
    <div class="decision-card__eyebrow">
      <span>Typed decision</span>
      <span class="decision-card__kind">{kindLabel}</span>
    </div>
    <p class="decision-card__question">{question}</p>
    <h2 id={titleId}>{answer}</h2>
    <p class="decision-card__answer-note">{answerNote}</p>
  </header>

  <section class="decision-card__confidence" aria-labelledby={meterLabelId}>
    <div class="decision-card__confidence-head">
      <h3 id={meterLabelId}>Confidence</h3>
      <strong>{confidencePercent}</strong>
    </div>
    <div class="decision-card__meter-wrap" style={`--decision-threshold:${GATE.confidenceMin * 100}%`}>
      <meter
        aria-labelledby={meterLabelId}
        min="0"
        max="1"
        low={GATE.uncertaintyMin}
        high={GATE.confidenceMin}
        optimum="1"
        value={decision.confidence}
      >{confidencePercent}</meter>
      <span class="decision-card__threshold" aria-hidden="true"></span>
    </div>
    <div class="decision-card__meter-labels" aria-hidden="true">
      <span>0</span>
      <span>Eligibility at {Math.round(GATE.confidenceMin * 100)}%</span>
      <span>100%</span>
    </div>
    <p class="decision-card__confidence-note">Confidence describes this answer's source. Review rules still apply.</p>
  </section>

  <section class="decision-card__review" aria-label="Review outcome">
    <strong>{reviewLabel}</strong>
    <p>{reviewDescription}</p>
  </section>

  <footer class="decision-card__provenance">
    <dl>
      <div><dt>Source</dt><dd>{sourceNames[decision.confidence_source]} <code>{decision.confidence_source}</code></dd></div>
      <div><dt>Model</dt><dd>{decision.model.id} · {decision.model.version}</dd></div>
      <div><dt>Runtime</dt><dd>{decision.model.runtime}</dd></div>
      <div><dt>Latency</dt><dd>{decision.latency_ms} ms</dd></div>
      {decision.model.sha256 && <div class="decision-card__hash"><dt>Weights SHA-256</dt><dd><code>{decision.model.sha256}</code></dd></div>}
    </dl>
  </footer>
</article>

<style>
  .decision-card {
    min-width: 0;
    padding: var(--space-5);
    border: var(--border-hairline);
    border-top: 4px solid var(--color-board);
    border-radius: var(--radius-card);
    background: var(--color-chalk);
    color: var(--color-ink);
  }

  .decision-card--review { border-top-color: var(--color-accent-deep); }
  .decision-card__eyebrow,
  .decision-card__confidence-head,
  .decision-card__meter-labels {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .decision-card__eyebrow {
    color: var(--color-ink-soft);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .decision-card__kind {
    padding: var(--space-1) var(--space-2);
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
    color: var(--color-board-deep);
    letter-spacing: normal;
  }

  .decision-card__question {
    margin: var(--space-4) 0 var(--space-1);
    color: var(--color-ink-soft);
    font-size: .875rem;
    font-weight: 700;
  }

  .decision-card h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3rem);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .decision-card__answer-note {
    margin: var(--space-2) 0 0;
    line-height: 1.5;
  }

  .decision-card__confidence,
  .decision-card__review,
  .decision-card__provenance {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: var(--border-hairline);
  }

  .decision-card__confidence-head h3 {
    margin: 0;
    font-size: 1rem;
  }

  .decision-card__confidence-head strong {
    font-size: 1.125rem;
    font-variant-numeric: tabular-nums;
  }

  .decision-card__meter-wrap { position: relative; margin-top: var(--space-2); }
  .decision-card meter { display: block; width: 100%; height: 16px; }
  .decision-card meter::-webkit-meter-bar { border: 0; border-radius: var(--radius-sm); background: var(--color-line); }
  .decision-card meter::-webkit-meter-optimum-value { border-radius: var(--radius-sm); background: var(--color-board); }
  .decision-card meter::-webkit-meter-suboptimum-value,
  .decision-card meter::-webkit-meter-even-less-good-value { border-radius: var(--radius-sm); background: var(--color-accent-deep); }
  .decision-card meter::-moz-meter-bar { border-radius: var(--radius-sm); background: var(--color-board); }
  .decision-card__threshold {
    position: absolute;
    top: -3px;
    bottom: -3px;
    left: var(--decision-threshold);
    width: 2px;
    background: var(--color-chalk);
    box-shadow: 0 0 0 1px var(--color-board-deep);
    pointer-events: none;
  }

  .decision-card__meter-labels {
    margin-top: var(--space-1);
    color: var(--color-ink-soft);
    font-size: .75rem;
    font-variant-numeric: tabular-nums;
  }

  .decision-card__confidence-note {
    margin: var(--space-2) 0 0;
    color: var(--color-ink-soft);
    font-size: .875rem;
    line-height: 1.5;
  }

  .decision-card__review {
    padding: var(--space-4);
    border: 0;
    border-inline-start: 4px solid var(--color-board);
    background: var(--color-paper);
  }

  .decision-card--review .decision-card__review { border-inline-start-color: var(--color-accent-deep); }
  .decision-card__review strong { display: block; font-size: 1rem; }
  .decision-card__review p { margin: var(--space-1) 0 0; line-height: 1.5; }
  .decision-card__provenance dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin: 0; }
  .decision-card__provenance dt { color: var(--color-ink-soft); font-size: .75rem; font-weight: 700; text-transform: uppercase; }
  .decision-card__provenance dd { margin: var(--space-1) 0 0; font-size: .875rem; line-height: 1.4; overflow-wrap: anywhere; }
  .decision-card__provenance code { font-size: .8em; overflow-wrap: anywhere; }
  .decision-card__hash { grid-column: 1 / -1; }

  @media (max-width: 420px) {
    .decision-card { padding: var(--space-4); }
    .decision-card__provenance dl { grid-template-columns: 1fr; }
  }
</style>
