---
import { Picture } from 'astro:assets';
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';
import placeholder from '../assets/landing-placeholder.png';
import type { PreviewLot } from '../data/preview-lots';

const { lot, first = false, base, index = 0 } = Astro.props as { lot: PreviewLot; first?: boolean; base: string; index?: number };
const tones = ['lime', 'pink', 'yellow', 'blue'];
---

<article class={`market-card market-card--${tones[index % tones.length]} market-card--preview`} aria-labelledby={`market-${lot.id}`}>
  <div class="market-card__media">
    <Picture
      src={placeholder}
      formats={['avif', 'webp']}
      widths={[240, 480]}
      sizes="148px"
      width={480}
      height={360}
      alt="Illustrated fish silhouette; no landing photograph"
      loading={first ? 'eager' : 'lazy'}
    />
    <div class="market-card__image-copy">
      <Badge label="Preview" tone="yellow" class="market-card__status" />
      <div class="market-card__image-facts">
        <h2 id={`market-${lot.id}`}>{lot.species}</h2>
        <p><span>{lot.weightG.toLocaleString('ja-JP')} g</span><span class="market-card__fact-divider"> · </span><span>{lot.lengthMm} mm</span></p>
        <small>Sample landing</small>
      </div>
    </div>
  </div>
  <div class="market-card__foot">
    <strong>¥{lot.priceJpy.toLocaleString('ja-JP')}</strong>
    <Button href={`${base}shop/lot/?id=${encodeURIComponent(lot.id)}`} variant="secondary" tone="ink" class="market-card__action">View</Button>
  </div>
</article>
