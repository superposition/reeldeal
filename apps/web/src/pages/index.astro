---
import BaseLayout from '../layouts/BaseLayout.astro';
import LotCard from '../components/LotCard.astro';
import { previewLots } from '../data/preview-lots';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Today's board"
  description="A demo marketplace for traceable fish lots from Kesennuma."
>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Kesennuma · today's board</p>
      <h1>From landing to trusted lot.</h1>
      <p class="hero__lead">
        Capture a fish landing, review a typed decision, then offer an approved lot
        to buyers. Every correction stays visible in the record.
      </p>
      <div class="hero__actions">
        <a class="button-link button-link--primary" href={`${base}intake/`}>Record a landing</a>
        <a class="button-link" href={`${base}shop/`}>Browse preview lots</a>
        <a class="button-link" href="#how-it-works">How it works</a>
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="board-title">
    <div class="section__head">
      <div>
        <p class="eyebrow">Market preview</p>
        <h2 id="board-title">Today's lots</h2>
      </div>
      <p>Sample data while the live intake and listing API are built.</p>
    </div>
    <div class="lot-grid">
      {previewLots.map((lot) => <LotCard lot={lot} />)}
    </div>
  </section>

  <section class="section workflow" id="how-it-works" aria-labelledby="workflow-title">
    <div class="shell">
      <p class="eyebrow">The workflow</p>
      <h2 id="workflow-title">One clear record from dock to buyer</h2>
      <ol class="workflow__steps">
        <li><strong>01 · Observe</strong><p>Camera and manual measurements become facts, with an operator-confirmed species label.</p></li>
        <li><strong>02 · Decide</strong><p>Laya runs in the browser and returns a typed answer. Uncertain results go to review.</p></li>
        <li><strong>03 · List</strong><p>An approved scan becomes a lot. A buyer signs a bid with their own wallet.</p></li>
        <li><strong>04 · Prove</strong><p>The sale record is hashed and anchored so later changes can be detected.</p></li>
      </ol>
    </div>
  </section>
</BaseLayout>
