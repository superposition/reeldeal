---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Scanner from '../../components/Scanner';
import '../../styles/intake.css';

const apiOrigin = import.meta.env.PUBLIC_API_ORIGIN
  ?? (import.meta.env.DEV ? 'http://127.0.0.1:8787' : '');
---

<BaseLayout
  title="Record a landing"
  description="Capture a Kesennuma fish landing as structured, reviewable facts."
  section="intake"
>
  <section class="intake-head">
    <div class="shell">
      <p class="eyebrow">Kesennuma · dockside</p>
      <h1>Record a landing</h1>
      <p>Photo first. Add only the facts you measured.</p>
    </div>
  </section>
  <div class="intake-main shell">
    <Scanner client:load apiOrigin={apiOrigin} />
  </div>
</BaseLayout>
