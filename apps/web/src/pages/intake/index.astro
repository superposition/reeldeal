---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Scanner from '../../components/Scanner';

const apiOrigin = import.meta.env.PUBLIC_API_ORIGIN
  ?? (import.meta.env.DEV ? 'http://127.0.0.1:8787' : '');
---

<BaseLayout
  title="Record a landing"
  description="Capture a Kesennuma fish landing as structured, reviewable facts."
  section="intake"
>
  <section class="page-heading shell">
    <p class="eyebrow">Dockside intake</p>
    <h1>Record a landing</h1>
    <p class="intro">Take a real photo and enter the measurements you have. Missing facts stay missing; review comes before any lot is listed.</p>
  </section>
  <div class="section shell">
    <Scanner client:load apiOrigin={apiOrigin} />
  </div>
</BaseLayout>
