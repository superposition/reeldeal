---
import { gate, ObservationInputSchema, TypedDecisionInputSchema } from '../../../../packages/domain/src/index';
import ReviewPanel from '../components/ReviewPanel.astro';
import type { ReviewSnapshot } from '../components/review-types';
import BaseLayout from '../layouts/BaseLayout.astro';

const observation = ObservationInputSchema.parse({
  scan_id: 'demo-scan-saba', captured_at: '2026-09-26T00:00:00.000Z',
  image_ref: 'demo:synthetic-no-photo:saba', source: 'manual',
  length_mm: 350, girth_mm: null, weight_g: 880, ice_temp_c: null,
  species_candidates: [{ label: 'saba', score: 0.92 }],
  species_label: 'saba', species_confirmed_by: 'demo-operator',
  scale_reading: { stable: true, grams: 880 },
});
const decision = TypedDecisionInputSchema.parse({
  scan_id: observation.scan_id, observation_id: 'demo-observation-saba',
  decision_id: 'stub:demo-scan-saba:demo-observation-saba:grade:rules-v1/questions-v1',
  question_id: 'grade', kind: 'choice', choice: 'small',
  score: null, score_raw: null, score_level: null, noul_value: null, noul_probability: null,
  confidence: 0.7, confidence_source: 'stub_heuristic',
  model: { id: 'reeldeal-stub', version: 'rules-v1/questions-v1', runtime: 'js', sha256: null },
  latency_ms: 0, rationale: 'Rule-based bracket from measured weight; not species or quality prediction.',
});
const review: ReviewSnapshot = {
  lot: { id: 'demo-lot-saba', scan_id: observation.scan_id, status: 'pending_review', gate_reason: 'low_decision_confidence' },
  original_observation: observation, effective_observation: observation,
  original_decision: decision, original_gate: gate(decision, observation), corrections: [],
};
const apiOrigin = import.meta.env.PUBLIC_API_ORIGIN
  ?? (import.meta.env.DEV ? 'http://127.0.0.1:8787' : '');
---

<BaseLayout
  title="Review gate preview"
  description="Static review fixture and a small correction form for the ReelDeal demo."
>
  <div class="section shell">
    <ReviewPanel review={review} apiOrigin={apiOrigin} fixture />
  </div>
</BaseLayout>
