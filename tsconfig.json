{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": true,
    "paths": {
      "@reeldeal/domain": ["./packages/domain/src/index.ts"],
      "@reeldeal/domain/*": ["./packages/domain/src/*"]
    }
  },
  "exclude": ["**/dist", "**/node_modules", "contracts/out"]
}
